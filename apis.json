{
 "version": 1,
 "apis": [
  {
   "name": "meteo",
   "category": "Météo",
   "desc": "Météo actuelle + prévisions 3 jours (weather_code = code WMO : 0 dégagé, 61 pluie, 95 orage)",
   "keywords": [
    "météo",
    "meteo",
    "temps",
    "pluie",
    "température",
    "chaleur",
    "vent",
    "prévision",
    "orage",
    "soleil",
    "climat"
   ],
   "source": "catalogue:Open-Meteo",
   "url": "https://api.open-meteo.com/v1/forecast",
   "params": {
    "latitude": {
     "type": "number",
     "desc": "latitude en degrés",
     "min": -90,
     "max": 90
    },
    "longitude": {
     "type": "number",
     "desc": "longitude en degrés",
     "min": -180,
     "max": 180
    }
   },
   "fixed": {
    "current": "temperature_2m,apparent_temperature,relative_humidity_2m,precipitation,weather_code,wind_speed_10m",
    "daily": "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max",
    "timezone": "auto",
    "forecast_days": 3
   },
   "extract": [
    "current",
    "daily"
   ],
   "example": {
    "latitude": 5.36,
    "longitude": -4.0
   },
   "taints": false
  },
  {
   "name": "geocode_ville",
   "category": "Météo",
   "desc": "Coordonnées (latitude, longitude) d'une ville : à utiliser avant meteo, qualite_air, lieux_proches",
   "keywords": [
    "ville",
    "coordonnées",
    "gps",
    "latitude",
    "longitude",
    "localiser",
    "où",
    "situer"
   ],
   "source": "catalogue:Open-Meteo",
   "url": "https://geocoding-api.open-meteo.com/v1/search",
   "params": {
    "name": {
     "type": "string",
     "desc": "nom de la ville"
    }
   },
   "fixed": {
    "count": 3,
    "language": "fr",
    "format": "json"
   },
   "extract": "results[]|name,admin1,country,latitude,longitude,timezone,population",
   "example": {
    "name": "Abidjan"
   },
   "taints": false
  },
  {
   "name": "qualite_air",
   "category": "Météo",
   "desc": "Qualité de l'air actuelle (indice européen AQI, PM2.5, PM10, ozone)",
   "keywords": [
    "air",
    "pollution",
    "qualité",
    "pm2",
    "particules",
    "smog",
    "respirer"
   ],
   "source": "catalogue:Open-Meteo",
   "url": "https://air-quality-api.open-meteo.com/v1/air-quality",
   "params": {
    "latitude": {
     "type": "number",
     "desc": "latitude en degrés",
     "min": -90,
     "max": 90
    },
    "longitude": {
     "type": "number",
     "desc": "longitude en degrés",
     "min": -180,
     "max": 180
    }
   },
   "fixed": {
    "current": "european_aqi,pm10,pm2_5,ozone,nitrogen_dioxide",
    "timezone": "auto"
   },
   "extract": "current",
   "example": {
    "latitude": 5.36,
    "longitude": -4.0
   },
   "taints": false
  },
  {
   "name": "altitude",
   "category": "Météo",
   "desc": "Altitude d'un point en mètres",
   "keywords": [
    "altitude",
    "élévation",
    "hauteur",
    "mètres"
   ],
   "source": "catalogue:Open-Meteo",
   "url": "https://api.open-meteo.com/v1/elevation",
   "params": {
    "latitude": {
     "type": "number",
     "desc": "latitude en degrés",
     "min": -90,
     "max": 90
    },
    "longitude": {
     "type": "number",
     "desc": "longitude en degrés",
     "min": -180,
     "max": 180
    }
   },
   "extract": "elevation",
   "example": {
    "latitude": 5.36,
    "longitude": -4.0
   },
   "taints": false
  },
  {
   "name": "meteo_historique",
   "category": "Météo",
   "desc": "Météo passée jour par jour (températures, pluie)",
   "keywords": [
    "historique",
    "passé",
    "hier",
    "météo",
    "pluie",
    "précédente",
    "archive"
   ],
   "source": "catalogue:Open-Meteo",
   "url": "https://archive-api.open-meteo.com/v1/archive",
   "params": {
    "latitude": {
     "type": "number",
     "desc": "latitude en degrés",
     "min": -90,
     "max": 90
    },
    "longitude": {
     "type": "number",
     "desc": "longitude en degrés",
     "min": -180,
     "max": 180
    },
    "start_date": {
     "type": "string",
     "desc": "AAAA-MM-JJ",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
     "type": "string",
     "desc": "AAAA-MM-JJ",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   },
   "fixed": {
    "daily": "temperature_2m_max,temperature_2m_min,precipitation_sum",
    "timezone": "auto"
   },
   "extract": "daily",
   "example": {
    "latitude": 5.36,
    "longitude": -4.0,
    "start_date": "2026-10-01",
    "end_date": "2026-10-03"
   },
   "taints": false
  },
  {
   "name": "soleil",
   "category": "Météo",
   "desc": "Heures de lever et coucher du soleil (UTC, ISO 8601)",
   "keywords": [
    "lever",
    "coucher",
    "soleil",
    "aube",
    "crépuscule",
    "nuit",
    "jour"
   ],
   "source": "catalogue:Sunrise and Sunset",
   "url": "https://api.sunrise-sunset.org/json",
   "params": {
    "lat": {
     "type": "number",
     "desc": "latitude",
     "min": -90,
     "max": 90
    },
    "lng": {
     "type": "number",
     "desc": "longitude",
     "min": -180,
     "max": 180
    }
   },
   "fixed": {
    "formatted": 0
   },
   "extract": "results",
   "example": {
    "lat": 5.36,
    "lng": -4.0
   },
   "taints": false
  },
  {
   "name": "seismes",
   "category": "Science",
   "desc": "Derniers séismes dans le monde (magnitude, lieu)",
   "keywords": [
    "séisme",
    "tremblement",
    "terre",
    "magnitude",
    "sismique"
   ],
   "source": "catalogue:USGS Earthquake Hazards Program",
   "url": "https://earthquake.usgs.gov/fdsnws/event/1/query",
   "params": {
    "minmagnitude": {
     "type": "number",
     "desc": "magnitude minimale",
     "default": 4.5,
     "min": 0,
     "max": 10
    },
    "limit": {
     "type": "integer",
     "desc": "nombre de résultats",
     "default": 5,
     "min": 1,
     "max": 10
    }
   },
   "fixed": {
    "format": "geojson",
    "orderby": "time"
   },
   "extract": "features[]|properties.mag,properties.place,properties.time,properties.url",
   "example": {},
   "taints": false
  },
  {
   "name": "fuseau_horaire",
   "category": "Temps",
   "desc": "Heure actuelle dans un fuseau (ex Europe/Paris, Asia/Tokyo, America/New_York)",
   "keywords": [
    "heure",
    "fuseau",
    "décalage",
    "horaire",
    "pays",
    "ville",
    "quelle",
    "heure"
   ],
   "source": "catalogue:Timezone WorldTime",
   "url": "https://worldtimeapi.org/api/timezone/{zone}",
   "params": {
    "zone": {
     "type": "string",
     "desc": "fuseau IANA",
     "pattern": "^[A-Za-z_]+(/[A-Za-z_\\-]+){0,2}$"
    }
   },
   "extract": [
    "datetime",
    "timezone",
    "utc_offset",
    "abbreviation"
   ],
   "example": {
    "zone": "Europe/Paris"
   },
   "taints": false
  },
  {
   "name": "jours_feries",
   "category": "Temps",
   "desc": "Jours fériés d'un pays pour une année (code pays ISO, CI = Côte d'Ivoire)",
   "keywords": [
    "férié",
    "fériés",
    "vacances",
    "congé",
    "holiday",
    "jour",
    "chômé"
   ],
   "source": "catalogue:Nager.Date",
   "url": "https://date.nager.at/api/v3/PublicHolidays/{year}/{country}",
   "params": {
    "year": {
     "type": "integer",
     "desc": "année",
     "min": 1990,
     "max": 2100
    },
    "country": {
     "type": "string",
     "desc": "code pays ISO 2 lettres",
     "default": "CI",
     "pattern": "^[A-Z]{2}$"
    }
   },
   "extract": "[]|date,localName,name",
   "example": {
    "year": 2026
   },
   "taints": false
  },
  {
   "name": "pays",
   "category": "Lieux",
   "desc": "Infos sur un pays : capitale, population, devises, langues, indicatif téléphonique",
   "keywords": [
    "pays",
    "capitale",
    "population",
    "indicatif",
    "devise",
    "langue",
    "nation"
   ],
   "source": "catalogue:REST Countries",
   "url": "https://restcountries.com/v3.1/name/{name}",
   "params": {
    "name": {
     "type": "string",
     "desc": "nom du pays (français ou anglais)"
    }
   },
   "fixed": {
    "fields": "name,capital,population,region,subregion,currencies,languages,idd,timezones"
   },
   "extract": "[]|name.common,capital,population,region,subregion,currencies,languages,idd,timezones",
   "example": {
    "name": "Côte d'Ivoire"
   },
   "post": {
    "limit": 2
   },
   "taints": false
  },
  {
   "name": "nominatim_recherche",
   "category": "Lieux",
   "desc": "Trouve un lieu ou une adresse (coordonnées, type) via OpenStreetMap",
   "keywords": [
    "adresse",
    "lieu",
    "trouver",
    "carte",
    "rue",
    "quartier",
    "endroit",
    "situer"
   ],
   "source": "catalogue:Nominatim",
   "url": "https://nominatim.openstreetmap.org/search",
   "params": {
    "q": {
     "type": "string",
     "desc": "adresse ou lieu"
    }
   },
   "fixed": {
    "format": "jsonv2",
    "limit": 3,
    "accept-language": "fr"
   },
   "extract": "[]|display_name,lat,lon,type",
   "example": {
    "q": "Plateau, Abidjan"
   },
   "min_interval": 1.1,
   "taints": true
  },
  {
   "name": "nominatim_inverse",
   "category": "Lieux",
   "desc": "Adresse ou quartier à partir de coordonnées",
   "keywords": [
    "adresse",
    "coordonnées",
    "quartier",
    "où",
    "suis-je"
   ],
   "source": "catalogue:Nominatim",
   "url": "https://nominatim.openstreetmap.org/reverse",
   "params": {
    "lat": {
     "type": "number",
     "desc": "latitude",
     "min": -90,
     "max": 90
    },
    "lon": {
     "type": "number",
     "desc": "longitude",
     "min": -180,
     "max": 180
    }
   },
   "fixed": {
    "format": "jsonv2",
    "zoom": 17,
    "accept-language": "fr"
   },
   "extract": [
    "display_name",
    "address"
   ],
   "example": {
    "lat": 5.36,
    "lon": -4.0
   },
   "min_interval": 1.1,
   "taints": true
  },
  {
   "name": "lieux_proches",
   "category": "Lieux",
   "desc": "Lieux proches (OpenStreetMap) : type = restaurant, fast_food, cafe, pharmacy, atm, bank, fuel, hospital, marketplace, bar",
   "keywords": [
    "près",
    "proche",
    "autour",
    "restaurant",
    "pharmacie",
    "distributeur",
    "banque",
    "station",
    "essence",
    "hôpital",
    "manger",
    "faim",
    "garba",
    "maquis",
    "café"
   ],
   "source": "hors-catalogue (OpenStreetMap Overpass)",
   "url": "https://overpass-api.de/api/interpreter",
   "params": {
    "latitude": {
     "type": "number",
     "desc": "latitude",
     "min": -90,
     "max": 90,
     "in": "body"
    },
    "longitude": {
     "type": "number",
     "desc": "longitude",
     "min": -180,
     "max": 180,
     "in": "body"
    },
    "type": {
     "type": "string",
     "desc": "type de lieu (valeur amenity)",
     "pattern": "^[a-z_]{3,30}$",
     "in": "body"
    },
    "radius": {
     "type": "integer",
     "desc": "rayon en mètres",
     "default": 1000,
     "min": 100,
     "max": 5000,
     "in": "body"
    }
   },
   "extract": "elements[]|tags.name,tags.cuisine,tags.opening_hours,tags.phone,lat,lon,center.lat,center.lon",
   "example": {
    "latitude": 5.36,
    "longitude": -4.0,
    "type": "restaurant"
   },
   "method": "POST",
   "form": {
    "data": "[out:json][timeout:20];nwr(around:{radius},{latitude},{longitude})[amenity={type}];out center 12;"
   },
   "timeout": 30,
   "taints": true
  },
  {
   "name": "change_ecb",
   "category": "Finance",
   "desc": "Taux de change officiels BCE (pas de XOF/FCFA : utiliser change_monde). Paramètres : base, symbols (ex USD,GBP)",
   "keywords": [
    "change",
    "taux",
    "devise",
    "euro",
    "dollar",
    "monnaie",
    "conversion"
   ],
   "source": "catalogue:Frankfurter",
   "url": "https://api.frankfurter.dev/v1/latest",
   "params": {
    "base": {
     "type": "string",
     "desc": "devise de base",
     "default": "EUR",
     "pattern": "^[A-Z]{3}$"
    },
    "symbols": {
     "type": "string",
     "desc": "devises voulues séparées par des virgules",
     "optional": true,
     "pattern": "^[A-Z]{3}(,[A-Z]{3}){0,15}$"
    }
   },
   "extract": [
    "base",
    "date",
    "rates"
   ],
   "example": {
    "symbols": "USD"
   },
   "taints": false
  },
  {
   "name": "change_monde",
   "category": "Finance",
   "desc": "Taux de change (160 devises dont XOF = FCFA ; 1 EUR = 655,957 XOF fixe). symbols filtre les devises",
   "keywords": [
    "change",
    "taux",
    "devise",
    "fcfa",
    "xof",
    "franc",
    "cfa",
    "dollar",
    "euro",
    "monnaie",
    "conversion"
   ],
   "source": "hors-catalogue (ExchangeRate-API open access)",
   "url": "https://open.er-api.com/v6/latest/{base}",
   "params": {
    "base": {
     "type": "string",
     "desc": "devise de base",
     "default": "EUR",
     "pattern": "^[A-Z]{3}$"
    },
    "symbols": {
     "type": "string",
     "desc": "devises voulues, ex XOF,USD",
     "default": "XOF,USD,EUR",
     "pattern": "^[A-Z]{3}(,[A-Z]{3}){0,15}$"
    }
   },
   "extract": [
    "base_code",
    "time_last_update_utc",
    "rates"
   ],
   "example": {
    "base": "USD",
    "symbols": "XOF,EUR"
   },
   "post": {
    "filter_keys": {
     "path": "rates",
     "param": "symbols"
    }
   },
   "taints": false
  },
  {
   "name": "change_historique",
   "category": "Finance",
   "desc": "Taux de change BCE à une date passée",
   "keywords": [
    "change",
    "historique",
    "taux",
    "passé",
    "devise",
    "date"
   ],
   "source": "catalogue:Frankfurter",
   "url": "https://api.frankfurter.dev/v1/{date}",
   "params": {
    "date": {
     "type": "string",
     "desc": "AAAA-MM-JJ",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "base": {
     "type": "string",
     "desc": "devise de base",
     "default": "EUR",
     "pattern": "^[A-Z]{3}$"
    },
    "symbols": {
     "type": "string",
     "desc": "devises voulues",
     "optional": true,
     "pattern": "^[A-Z]{3}(,[A-Z]{3}){0,15}$"
    }
   },
   "extract": [
    "base",
    "date",
    "rates"
   ],
   "example": {
    "date": "2025-01-02",
    "symbols": "USD"
   },
   "taints": false
  },
  {
