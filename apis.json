   "category": "Sécurité",
   "desc": "Enregistrements DNS d'un domaine (type A, AAAA, MX, TXT, NS, CNAME)",
   "keywords": [
    "dns",
    "domaine",
    "enregistrement",
    "mx",
    "txt",
    "résolution",
    "nom"
   ],
   "source": "hors-catalogue (Google Public DNS)",
   "url": "https://dns.google/resolve",
   "params": {
    "name": {
     "type": "string",
     "desc": "domaine",
     "pattern": "^([a-z0-9-]{1,63}\\.)+[a-z]{2,24}$"
    },
    "type": {
     "type": "string",
     "desc": "type d'enregistrement",
     "default": "A",
     "pattern": "^[A-Z]{1,10}$"
    }
   },
   "extract": [
    "Status",
    "Answer[]|name,type,TTL,data"
   ],
   "example": {
    "name": "example.com"
   },
   "taints": true
  },
  {
   "name": "rdap",
   "category": "Sécurité",
   "desc": "Informations d'enregistrement d'un domaine (RDAP / whois) : dates, statut, serveurs de noms",
   "keywords": [
    "whois",
    "rdap",
    "domaine",
    "propriétaire",
    "enregistrement",
    "expiration",
    "création"
   ],
   "source": "hors-catalogue (RDAP)",
   "url": "https://rdap.org/domain/{domain}",
   "params": {
    "domain": {
     "type": "string",
     "desc": "domaine",
     "pattern": "^([a-z0-9-]{1,63}\\.)+[a-z]{2,24}$"
    }
   },
   "extract": [
    "ldhName",
    "status",
    "events",
    "nameservers"
   ],
   "example": {
    "domain": "example.com"
   },
   "max_chars": 1500,
   "any_redirect": true,
   "taints": true
  },
  {
   "name": "certificats",
   "category": "Sécurité",
   "desc": "Certificats TLS émis pour un domaine (sous-domaines connus, crt.sh). q = %.exemple.com",
   "keywords": [
    "certificat",
    "tls",
    "ssl",
    "sous-domaine",
    "crt",
    "transparence"
   ],
   "source": "hors-catalogue (crt.sh)",
   "url": "https://crt.sh/",
   "params": {
    "q": {
     "type": "string",
     "desc": "domaine, ex %.example.com",
     "pattern": "^(%\\.)?([a-z0-9-]+\\.)+[a-z]{2,24}$"
    }
   },
   "fixed": {
    "output": "json"
   },
   "extract": "[]|name_value,issuer_name,not_before,not_after",
   "example": {
    "q": "%.example.com"
   },
   "post": {
    "dedupe": "name_value",
    "limit": 15
   },
   "timeout": 40,
   "taints": true
  },
  {
   "name": "fuites_domaine",
   "category": "Sécurité",
   "desc": "Fuites de données publiques connues impliquant un domaine (HaveIBeenPwned, liste des fuites)",
   "keywords": [
    "fuite",
    "données",
    "breach",
    "pwned",
    "piratage",
    "domaine",
    "compromis"
   ],
   "source": "catalogue:HaveIBeenPwned (liste publique des fuites)",
   "url": "https://haveibeenpwned.com/api/v3/breaches",
   "params": {
    "domain": {
     "type": "string",
     "desc": "domaine",
     "pattern": "^([a-z0-9-]{1,63}\\.)+[a-z]{2,24}$"
    }
   },
   "extract": "[]|Name,Title,BreachDate,PwnCount,DataClasses",
   "example": {
    "domain": "adobe.com"
   },
   "taints": true
  }
 ]
}